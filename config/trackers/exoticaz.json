{
  "id": "exoticaz",
  "name": "ExoticaZ",
  "baseUrl": "https://exoticaz.to",
  "enabled": false,
  "engine": "unit3d",
  "login": {
    "url": "login",
    "method": "POST",
    "contentType": "form",
    "cookieOnly": true
  },
  "fetch": {
    "fields": {
      "uploadedBytes": {
        "regex": "fa-arrow-up[\\s\\S]{0,40}?</i>\\s*(?<value>[\\d.,]+\\s*[KMGTPE]?i?B)",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": "fa-arrow-down[\\s\\S]{0,40}?</i>\\s*(?<value>[\\d.,]+\\s*[KMGTPE]?i?B)",
        "transform": "bytes"
      },
      "ratio": {
        "regex": "fa-signal[\\s\\S]{0,40}?</i>\\s*(?<value>[\\d.,]+)",
        "transform": "number"
      },
      "bufferBytes": {
        "regex": "fa-database[\\s\\S]{0,40}?</i>\\s*(?<value>[\\d.,]+\\s*[KMGTPE]?i?B)",
        "transform": "bytes"
      },
      "seeding": {
        "regex": "Seeding:</a>\\s*(?<value>\\d+)",
        "transform": "integer"
      },
      "seedBonus": {
        "regex": "Bonus:</a>\\s*(?<value>[\\d.,]+)",
        "transform": "string"
      }
    }
  },
  "dashboard": {
    "byteUnit": "decimal"
  }
}
