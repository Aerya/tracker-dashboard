{
  "id": "exoticaz",
  "name": "ExoticaZ",
  "baseUrl": "https://exoticaz.to",
  "enabled": false,
  "engine": "avistaznetwork",
  "login": {
    "url": "login",
    "preStep": {
      "url": "login",
      "extract": {
        "_csrf": { "regex": "name=\"_token\"\\s+value=\"(?<value>[^\"]+)\"" }
      },
      "includeHiddenInputs": true
    },
    "body": {
      "_token": "{{_csrf}}",
      "username_email": "{{username}}",
      "password": "{{password}}",
      "remember": "on"
    }
  }
}
