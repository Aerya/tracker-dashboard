{
  "id": "hdforever",
  "name": "HD-Forever",
  "baseUrl": "https://hdf.world",
  "enabled": true,
  "engine": "gazelle",
  "login": {
    "url": "login.php",
    "method": "POST",
    "contentType": "form",
    "body": {
      "username": "{{username}}",
      "password": "{{password}}",
      "login": "Se connecter",
      "keeplogged": "1"
    },
    "otpStep": {
      "urlContains": "login.php",
      "action": "login.php?act=otp",
      "field": "otp_code",
      "body": {
        "validate_otp": "Valider le code"
      }
    },
    "failurePatterns": [
      "Identifiant ou mot de passe incorrect",
      "type=\"password\"",
      "href=\"login.php\"",
      "Entrer</a>"
    ]
  },
  "fetch": {
    "mode": "http",
    "fields": {
      "uploadedBytes": {
        "regex": "class=\"stat tooltip up\" title=\"(?<value>[^\"]+)\"",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": "class=\"stat tooltip dl\" title=\"(?<value>[^\"]+)\"",
        "transform": "bytes"
      },
      "ratio": {
        "regex": "stats_ratio[^>]*>Ratio[^<]*<[^>]*><span class=\"tooltip r\\d+\" title=\"(?<value>[^\"]+)\"",
        "transform": "number"
      },
      "seedBonus": {
        "regex": "action=rate[^>]+>(?<value>[\\d,]+)<",
        "transform": "string"
      },
      "unreadMessages": {
        "regex": "data-notification-type=['\"]Inbox['\"][^>]*>[^<]*?(?<value>\\d+|\\bun) nouveau",
        "transform": "string"
      }
    }
  },
  "dashboard": {
    "byteUnit": "decimal"
  }
}
