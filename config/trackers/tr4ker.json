{
  "id": "tr4ker",
  "name": "TR4KER",
  "baseUrl": "https://tr4ker.net",
  "enabled": true,
  "login": {
    "url": "login",
    "method": "POST",
    "contentType": "form",
    "body": {
      "username": "{{username}}",
      "email": "{{username}}",
      "password": "{{password}}"
    },
    "failurePatterns": [
      "Page introuvable"
    ],
    "cookieOnly": true
  },
  "fetch": {
    "url": "api/me",
    "mode": "http",
    "responseType": "json",
    "fields": {
      "uploadedBytes": {
        "path": "bonus_upload",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "path": "bonus_download",
        "transform": "bytes"
      },
      "ratio": {
        "path": "ratio",
        "transform": "number"
      },
      "memberClass": {
        "path": "role",
        "transform": "string"
      }
    },
    "extraFetch": {
      "url": "api/me/stats",
      "responseType": "json",
      "field": "seeding",
      "path": "statistics.torrents_seeding",
      "transform": "integer"
    }
  },
  "dashboard": {
    "byteUnit": "decimal"
  }
}
