{
  "id": "tr4ker",
  "name": "TR4KER",
  "baseUrl": "https://tr4ker.net",
  "enabled": true,
  "login": {
    "url": "login",
    "method": "POST",
    "contentType": "form",
    "body": {
      "username": "{{username}}",
      "email": "{{username}}",
      "password": "{{password}}"
    },
    "failurePatterns": [
      "Page introuvable"
    ],
    "cookieOnly": true
  },
  "fetch": {
    "url": "api/me/stats",
    "mode": "http",
    "responseType": "json",
    "fields": {
      "uploadedBytes": {
        "path": "summary.uploaded",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "path": "summary.downloaded",
        "transform": "bytes"
      },
      "seeding": {
        "path": "statistics.torrents_seeding",
        "transform": "integer"
      }
    },
    "extraFetch": {
      "url": "api/me",
      "field": "memberClass",
      "regex": "\"role\":\"(?<value>[^\"]+)\"",
      "transform": "string"
    }
  },
  "dashboard": {
    "byteUnit": "decimal"
  }
}
