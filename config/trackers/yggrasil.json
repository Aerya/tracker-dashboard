{
  "id": "yggrasil",
  "name": "Yggrasil",
  "baseUrl": "https://yggrasil.xyz",
  "enabled": false,

  "login": {
    "url": "/login",
    "postUrl": "/login",
    "method": "POST",
    "contentType": "form",

    "preStep": {
      "url": "/login",
      "includeHiddenInputs": true,
      "extract": {
        "_csrf": {
          "regex": "name=\"_token\"[^>]*?value=\"(?<value>[^\"]+)\""
        }
      }
    },

    "body": {
      "_token": "{{_csrf}}",
      "email": "{{username}}",
      "password": "{{password}}"
    },

    "failurePatterns": [
      "<title>Connexion — Yggrasil</title>"
    ]
  },

  "fetch": {
    "url": "/profile",
    "responseType": "html",

    "fields": {
      "uploadedBytes": {
        "regex": "<span class=\"lbl\">Uploadé</span>\\s*<div class=\"val(?: [^\"]*)?\">(?<value>[^<]+)</div>",
        "transform": "bytes"
      },

      "downloadedBytes": {
        "regex": "<span class=\"lbl\">Téléchargé</span>\\s*<div class=\"val(?: [^\"]*)?\">(?<value>[^<]+)</div>",
        "transform": "bytes"
      },

      "ratio": {
        "regex": "<span class=\"lbl\">Ratio</span>\\s*<div class=\"val(?: [^\"]*)?\">\\s*(?<value>[^<\\s][^<]*?)\\s*</div>",
        "transform": "number"
      },

      "seedTime": {
        "regex": "<span class=\"lbl\">Temps de seed</span>\\s*<div class=\"val\"[^>]*>(?<value>[^<]+)</div>",
        "transform": "string"
      }
    }
  },

  "dashboard": {
    "byteUnit": "decimal"
  }
}
