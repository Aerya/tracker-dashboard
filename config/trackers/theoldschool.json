{
  "id": "theoldschool",
  "name": "The Old School",
  "baseUrl": "https://theoldschool.cc",
  "enabled": true,
  "engine": "unit3d",
  "login": {},
  "fetch": {
    "extraFetch": {
      "url": "users/{{username}}",
      "field": "memberClass",
      "regex": "profile__username[\\s\\S]*?title=\"(?<value>[^\"]+)\"",
      "transform": "string"
    }
  }
}
