{
  "id": "hdonly",
  "name": "HD-Only",
  "baseUrl": "https://hd-only.org",
  "enabled": true,
  "ratioless": true,
  "login": {
    "url": "login.php",
    "method": "POST",
    "contentType": "form",
    "body": {
      "username": "{{username}}",
      "password": "{{password}}",
      "keeplogged": "1",
      "login": "Se connecter"
    },
    "failurePatterns": [
      "Identifiant ou mot de passe incorrect",
      "type=\"password\""
    ]
  },
  "fetch": {
    "url": "index.php",
    "responseType": "html",
    "fields": {
      "uploadedBytes": {
        "regex": "Envoy[\\s\\S]{0,160}?(?<value>[\\d\\s.,]+\\s*[KMGTPE]?i?B)",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": "Re[\\s\\S]{0,160}?(?<value>[\\d\\s.,]+\\s*[KMGTPE]?i?B)",
        "transform": "bytes"
      },
      "unreadMessages": {
        "regex": "data-notification-type=['\"]Inbox['\"][^>]*>[^<]*?(?<value>\\d+|\\bun) nouveau",
        "transform": "string"
      }
    }
  },
  "dashboard": {
    "byteUnit": "decimal"
  }
}
