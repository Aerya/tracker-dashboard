{
  "id": "hdonly",
  "name": "HD-Only",
  "baseUrl": "https://hd-only.org",
  "enabled": true,
  "engine": "gazelle",
  "login": {
    "body": {
      "username": "{{username}}",
      "password": "{{password}}",
      "keeplogged": "1",
      "login": "Se connecter"
    },
    "failurePatterns": [
      "Identifiant ou mot de passe incorrect",
      "type=\"password\"",
      "href=\"login.php\"",
      "Entrer</a>"
    ]
  },
  "fetch": {
    "mode": null,
    "fields": {
      "uploadedBytes": {
        "regex": "Envoy[\\s\\S]{0,160}?(?<value>[\\d\\s.,]+\\s*[KMGTPE]?i?B)",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": "Re[\\s\\S]{0,160}?(?<value>[\\d\\s.,]+\\s*[KMGTPE]?i?B)",
        "transform": "bytes"
      },
      "unreadMessages": {
        "regex": "data-notification-type=['\"]Inbox['\"][^>]*>[^<]*?(?<value>\\d+|\\bun) nouveau",
        "transform": "string"
      }
    }
  },
  "dashboard": {
    "byteUnit": "decimal"
  },
  "ratioless": true
}
