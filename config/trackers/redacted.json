{
  "id": "redacted",
  "name": "Redacted",
  "baseUrl": "https://redacted.sh",
  "enabled": true,
  "engine": "gazelle",
  "login": {
    "url": "login.php",
    "method": "POST",
    "contentType": "form",
    "otpField": "qrcode_confirm"
  },
  "fetch": {
    "fields": {
      "requiredRatio": {
        "regex": "id=\"stats_required\"[^>]*title=\"Required Ratio: (?<value>[^\"]+)\"",
        "transform": "number"
      },
      "unreadMessages": {
        "regex": "data-noty-type=['\"]Inbox['\"][^>]*>[^<]*?(?<value>\\d+)",
        "transform": "integer"
      }
    }
  },
  "dashboard": {
    "byteUnit": "decimal"
  }
}
