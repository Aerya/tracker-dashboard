{
  "id": "phoenixproject",
  "name": "Phoenix Project",
  "baseUrl": "https://phoenixproject.app",
  "enabled": true,
  "login": {
    "url": "login.php",
    "method": "POST",
    "contentType": "form",
    "mode": "browser",
    "body": {
      "username": "{{username}}",
      "password": "{{password}}",
      "twofa": "{{totp}}",
      "login": "Log in"
    },
    "failurePatterns": [
      "This is a mirage",
      "Enter</a>"
    ]
  },
  "fetch": {
    "url": "index.php",
    "mode": "browser",
    "responseType": "html",
    "fields": {
      "uploadedBytes": {
        "regex": "id=\"stats_seeding\"[\\s\\S]{0,200}?title=\"(?<value>[^\"]+)\"",
        "transform": "bytes"
      },
      "downloadedBytes": {
        "regex": "id=\"stats_leeching\"[\\s\\S]{0,200}?title=\"(?<value>[^\"]+)\"",
        "transform": "bytes"
      },
      "ratio": {
        "regex": "id=\"stats_ratio\"[\\s\\S]{0,200}?title=\"(?<value>[^\"]+)\"",
        "transform": "number"
      },
      "seedBonus": {
        "regex": "Bonus \\((?<value>[^)]+)\\)",
        "transform": "string"
      }
    }
  },
  "dashboard": { "byteUnit": "binary" }
}
